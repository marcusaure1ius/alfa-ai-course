{
  "name": "@neurokurs/course-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Course Control Plane for the n8n Entrepreneur Starter Kit",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "auth:bootstrap-admin": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "test:watch": "vitest",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@workflow/core": "4.7.0",
    "@workflow/next": "4.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "shadcn": "4.16.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@workflow/vitest": "4.0.15",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0",
    "workflow": "4.7.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  }
}
