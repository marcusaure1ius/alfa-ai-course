# Safe local defaults only. Copy to .env.local; do not add cloud credentials.
VERCEL_ENV=development
PLATFORM_PROVIDER=fake
DATABASE_URL=postgresql://platform:local-example-not-a-secret@127.0.0.1:55432/course_platform
APP_ORIGIN=http://localhost:3000
# Generate a unique value locally; this example must never be used in production.
AUTH_SECRET=local-example-not-a-secret-change-before-production
