# Safe local defaults only. Copy to .env.local; do not add cloud credentials.
VERCEL_ENV=development
PLATFORM_PROVIDER=fake
DATABASE_URL=postgresql://platform:local-example-not-a-secret@127.0.0.1:55432/course_platform
# Local migration fallback. Production sets a direct credential separately.
DATABASE_URL_UNPOOLED=postgresql://platform:local-example-not-a-secret@127.0.0.1:55432/course_platform
APP_ORIGIN=http://localhost:3000
# Generate a unique value locally; this example must never be used in production.
AUTH_SECRET=local-example-not-a-secret-change-before-production
# CRON_SECRET is production-only and intentionally has no local placeholder.
# Production-only values are intentionally absent here:
# TIMEWEB_API_TOKEN, TIMEWEB_SMOKE_BUDGET_RUB,
# TIMEWEB_SMOKE_PROJECT_ID, TIMEWEB_SMOKE_SSH_KEY_ID,
# AUTH_FACTOR_ENCRYPTION_KEY.
# Kill-switches TIMEWEB_MUTATIONS_ENABLED and TIMEWEB_CAPABILITIES_VERIFIED
# plus disposable attestations TIMEWEB_SMOKE_EXCLUSIVE_ACCOUNT and
# TIMEWEB_SMOKE_EXCLUSIVE_DNS_HOSTNAME must never be enabled in local or
# preview environments.
