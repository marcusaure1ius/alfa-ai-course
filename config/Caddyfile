{
	admin 127.0.0.1:2019
}

{$N8N_HOST} {
	encode zstd gzip

	reverse_proxy n8n:5678 {
		health_uri /healthz
		health_interval 30s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
