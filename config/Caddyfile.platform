{
	admin 127.0.0.1:2019

	# Блок log внутри сайта настраивает только access-лог. Ошибки reverse_proxy
	# (недоступный upstream, таймаут) пишет default-логгер, и полный URI с
	# секретом ушёл бы туда без фильтра.
	#
	# Набор фильтров обязан совпадать со вторым логгером ниже: гейт требует
	# одинаковую редакцию у КАЖДОГО логгера, а не у скольких-то.
	#
	# Query вырезается ЦЕЛИКОМ, а не по списку имён параметров. Список трижды
	# оказывался неполным: сначала не было code, потом oauth_token и
	# oauth_verifier из OAuth1-callback n8n, а сверка имён к тому же чувствительна
	# к регистру — ?Token= не совпадал с token. Перечислять секретные имена
	# заранее нельзя: их набор задаёт n8n и внешние провайдеры, а не мы. Поэтому
	# в логе остаётся только путь. Диагностическая цена признана приемлемой:
	# state и прочие несекретные параметры тоже не попадают в лог.
	#
	# Заголовки запроса удаляются ЦЕЛИКОМ по той же причине, что и query.
	# Перечислять имена нельзя: вебхуки n8n используют headerAuth, где имя
	# заголовка выбирает сам ученик, а значение и есть секрет вебхука — четыре
	# workflow репозитория так и настроены. Плюс сверка имени идёт с канонической
	# формой Go: X-N8N-API-KEY as-is не совпадал никогда и оставался no-op.
	# Состав того, что остаётся в записи, — в docs/security.md. Здесь он
	# намеренно не пересказан: копия уже расходилась с фактом.
	#
	# Ответные заголовки удаляются целиком по той же причине, что и запросные:
	# их имена задают n8n и сам ученик (Respond to Webhook принимает
	# произвольные заголовки), поэтому любой список неполон по построению.
	# «Оставить только Location» в stock Caddy невыразимо: точечный фильтр при
	# удалённой родительской карте мёртв при любом порядке применения.
	# Решение и диагностический размен записаны в docs/security.md (T-0127).
	# Referer отдельно не фильтруется: он входит в удаляемую карту заголовков.
	log default {
		format filter {
			wrap console
			fields {
				request>uri regexp "\?.*" "?REDACTED"
				request>headers delete
				resp_headers delete
			}
		}
	}
}

{$N8N_HOST} {
	encode zstd gzip

	# Инструмент не предназначен для поисковой выдачи. Без собственного
	# robots.txt любой неизвестный путь уходит в n8n, а тот отдаёт SPA-оболочку
	# с кодом 200 — то есть неограниченное число URL этого домена выглядит как
	# страница входа под брендом n8n.io.
	#
	# Порядок блоков handle в файле роли не играет: Caddy сортирует их по
	# специфичности матчера, а не по месту в файле. /robots.txt выигрывает у
	# общего handle откуда угодно — проверено живым запросом при блоке,
	# перенесённом за catch-all.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Disallow: /
Allow: /{$SITE_VERIFICATION_FILE:.site-verification-not-configured}
` 200
	}

	# Публичный endpoint подтверждения права собственности в поисковой консоли
	# (T-0117, T-0123). Сам файл не секрет — он и должен быть публичным, — но он
	# привязан к аккаунту владельца, а не к сайту. Этот профиль едет в публичном
	# релизном артефакте и разворачивается на произвольных хостах, поэтому имя
	# файла приходит из среды конкретного хоста: посторонняя установка не должна
	# отдавать чужое доказательство владения. Тело выводится из имени файла —
	# поисковая консоль требует ровно `google-site-verification: <имя файла>`.
	#
	# Живёт в конфиге, а не файлом на диске, потому что переустановка среды
	# затёрла бы файл, а подтверждение требуется сохранять и после проверки.
	# Путь исключён из Disallow выше: иначе проверка может не получить файл.
	#
	# Переменная не должна приходить ПУСТОЙ. Подстановка {$VAR:default} читает
	# default только когда переменная не определена вовсе; определённое пустое
	# значение оставляет матчер `/`. Живой запрос при пустой переменной:
	# GET / отдаёт 200 с телом `google-site-verification: ` вместо редактора n8n,
	# а robots.txt вырождается в `Disallow: /` плюс `Allow: /` — правило равной
	# длины снимает запрет обхода, то есть заодно отменяется мера T-0117.
	# Отсюда `:-` в docker-compose.platform.yml.
	#
	# Отказ тихий: код ответа остаётся 200, поэтому проверять применение надо по
	# ТЕЛУ корня, а не по коду. Признак поломки — `google-site-verification:` в
	# ответе на `/`.
	handle /{$SITE_VERIFICATION_FILE:.site-verification-not-configured} {
		header Content-Type "text/html; charset=utf-8"
		respond "google-site-verification: {$SITE_VERIFICATION_FILE:.site-verification-not-configured}" 200
	}

	# T-0120: анонимный вход на корень называет оператора и отношения сторон.
	# Google помечал хост как «обманные страницы»: чужой бренд в title и форма
	# пароля без указания, кто оператор. Руководство Google по социальной
	# инженерии требует не убирать чужой бренд, а явно обозначать отношения
	# сторон. Матчер точный: перехватывается ТОЛЬКО корень; вход /signin, REST,
	# статика редактора и вебхуки идут в n8n как раньше. Робот и человек
	# получают одно и то же содержимое — различие было бы маскировкой и
	# отдельным нарушением. Текст согласован владельцем (T-0120).
	# В HTML намеренно нет блока <style>: фигурные скобки внутри respond Caddy
	# разбирает как плейсхолдеры, поэтому стили только inline-атрибутами.
	handle / {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Neurokurs — учебная среда n8n</title>
</head>
<body style="margin:0;padding:48px 24px;font-family:system-ui,-apple-system,sans-serif;background:#fafafa;color:#1a1a1a">
<main style="max-width:560px;margin:0 auto">
<h1 style="font-size:1.6rem">Учебная среда Neurokurs</h1>
<p>Это персональная учебная среда участника курса Neurokurs. Доступ к ней есть только у ученика, за которым она закреплена.</p>
<p>Среда работает на n8n — инструменте автоматизации с открытым исходным кодом. n8n — продукт n8n GmbH; оператор этой среды — курс Neurokurs (<a href="https://neurokurs.ru">neurokurs.ru</a>), не аффилированный с n8n GmbH.</p>
<p><a href="/signin" style="display:inline-block;padding:12px 20px;background:#1a1a1a;color:#ffffff;border-radius:8px;text-decoration:none">Войти в учебную среду</a></p>
<p style="margin-top:40px;font-size:0.85rem;color:#555555"><a href="https://neurokurs.ru" style="color:#555555">neurokurs.ru</a></p>
</main>
</body>
</html>` 200
	}

	@public_endpoints path /healthz /healthz/readiness /webhook/* /webhook-test/* /form/* /form-test/*
	handle @public_endpoints {
		reverse_proxy n8n:5678
	}

	@management {
		path /api/v1/*
		header X-Neurokurs-Management {$N8N_GATE_MANAGEMENT_SECRET}
	}
	handle @management {
		reverse_proxy n8n:5678 {
			header_up -X-Neurokurs-Management
		}
	}

	# ADR-0016: ученик входит в n8n по собственному аккаунту, поэтому слой
	# промежуточной авторизации убран — аутентификацию выполняет сам n8n.
	# Канал управления выше сохранён: без него платформа не создаёт приглашения.
	handle {
		reverse_proxy n8n:5678 {
			health_uri /healthz
			health_interval 30s
			health_timeout 5s
		}
	}

	header {
		# Дублирует robots.txt на уровне заголовка: он действует и на ответы,
		# которые робот получил не через обход корня.
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				# Набор фильтров обязан совпадать с default-логгером выше: тот
				# покрывает ошибки reverse_proxy, этот — access-лог, и они видят
				# разные запросы. Почему вырезается целиком, а не по именам, —
				# объяснено там же.
				request>uri regexp "\?.*" "?REDACTED"
				request>headers delete
				resp_headers delete
			}
		}
	}
}
