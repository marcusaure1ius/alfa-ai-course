{
	admin 127.0.0.1:2019

	# Блок log внутри сайта настраивает только access-лог. Ошибки reverse_proxy
	# (недоступный upstream, таймаут) пишет default-логгер, и полный URI с
	# одноразовым токеном приглашения ушёл бы туда без фильтра.
	log default {
		format filter {
			wrap console
			fields {
				request>uri query {
					replace token REDACTED
				}
				request>headers>Cookie delete
				request>headers>X-N8N-API-KEY delete
				request>headers>X-Neurokurs-Management delete
			}
		}
	}
}

{$N8N_HOST} {
	encode zstd gzip

	# Инструмент не предназначен для поисковой выдачи. Без собственного
	# robots.txt любой неизвестный путь уходит в n8n, а тот отдаёт SPA-оболочку
	# с кодом 200 — то есть неограниченное число URL этого домена выглядит как
	# страница входа под брендом n8n.io. Свой robots.txt должен стоять до
	# общего handle, иначе его перехватит проксирование.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Disallow: /
` 200
	}

	@public_endpoints path /healthz /healthz/readiness /webhook/* /webhook-test/* /form/* /form-test/*
	handle @public_endpoints {
		reverse_proxy n8n:5678
	}

	@management {
		path /api/v1/*
		header X-Neurokurs-Management {$N8N_GATE_MANAGEMENT_SECRET}
	}
	handle @management {
		reverse_proxy n8n:5678 {
			header_up -X-Neurokurs-Management
		}
	}

	# ADR-0016: ученик входит в n8n по собственному аккаунту, поэтому слой
	# промежуточной авторизации убран — аутентификацию выполняет сам n8n.
	# Канал управления выше сохранён: без него платформа не создаёт приглашения.
	handle {
		reverse_proxy n8n:5678 {
			health_uri /healthz
			health_interval 30s
			health_timeout 5s
		}
	}

	header {
		# Дублирует robots.txt на уровне заголовка: он действует и на ответы,
		# которые робот получил не через обход корня.
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				# ADR-0016: одноразовое приглашение n8n приходит как /signup?token=...
				# и ведёт себя как секрет — по нему задаётся пароль аккаунта. Путь
				# не входит в allowlist, поэтому проходит общим handle и попал бы
				# в лог целиком. Снятый ticket больше не существует.
				#
				# Только блочная форма: однострочный вариант Caddy принимает молча,
				# но подпараметры не читает и оставляет actions пустым, то есть
				# редакция не выполняется вообще. Проверяется по caddy adapt.
				request>uri query {
					replace token REDACTED
				}
				request>headers>Cookie delete
				request>headers>X-N8N-API-KEY delete
				request>headers>X-Neurokurs-Management delete
			}
		}
	}
}
