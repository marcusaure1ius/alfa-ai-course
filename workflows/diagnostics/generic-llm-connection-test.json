    {"parameters":{"method":"GET","url":"={{ $json.baseUrl.replace(/\\/$/, '') + '/models' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{"timeout":30000,"response":{"response":{"fullResponse":true,"neverError":true,"responseFormat":"json"}}}},"id":"a3333333-3333-4333-8333-333333333333","name":"Discover Models","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-270,100],"credentials":{"httpHeaderAuth":{"id":"REPLACE_WITH_GENERIC_LLM_CREDENTIAL_ID","name":"Generic LLM Bearer Header"}},"onError":"continueRegularOutput"},
    {"parameters":{"jsCode":"const r=$input.first().json; const status=Number(r.statusCode ?? 0); const body=r.body ?? r; let discovery='unavailable'; let models=[]; if(status>=200&&status<300&&Array.isArray(body?.data)){discovery='available';models=body.data.map(x=>x?.id).filter(x=>typeof x==='string');} return [{json:{discovery,models,warning:discovery==='available'?null:'MODEL_DISCOVERY_UNAVAILABLE'}}];"},"id":"a4444444-4444-4444-8444-444444444444","name":"Detect Discovery Capability","type":"n8n-nodes-base.code","typeVersion":2,"position":[-30,100]},
    {"parameters":{"assignments":{"assignments":[{"id":"selected-model","name":"selectedModel","value":"={{ $('Test Profile - Edit Me').first().json.model }}","type":"string"},{"id":"discovery-status","name":"discovery","value":"={{ $json.discovery }}","type":"string"},{"id":"discovery-warning","name":"discoveryWarning","value":"={{ $json.warning }}","type":"string"}]},"options":{}},"id":"a5555555-5555-4555-8555-555555555555","name":"Manual Model Fallback","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[210,100]},
    {"parameters":{"method":"POST","url":"={{ $('Test Profile - Edit Me').first().json.baseUrl.replace(/\\/$/, '') + '/chat/completions' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({model:$json.selectedModel,messages:[{role:'user',content:'Reply with exactly: connection-ok'}],temperature:0,max_tokens:16}) }}","options":{"timeout":120000,"response":{"response":{"fullResponse":true,"neverError":true,"responseFormat":"json"}}}},"id":"a6666666-6666-4666-8666-666666666666","name":"Minimal Completion","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[450,100],"credentials":{"httpHeaderAuth":{"id":"REPLACE_WITH_GENERIC_LLM_CREDENTIAL_ID","name":"Generic LLM Bearer Header"}},"onError":"continueRegularOutput"},
    {"parameters":{"jsCode":"const r=$input.first().json; const status=Number(r.statusCode ?? 0); const body=r.body ?? r; const context=$('Manual Model Fallback').first().json; let code=null; if(status===401||status===403)code='AUTH_FAILED'; else if(status===429)code='RATE_LIMITED'; else if(status===404||(status===400&&/model/i.test(JSON.stringify(body))))code='MODEL_NOT_FOUND'; else if(status===0||status>=500)code='PROVIDER_UNAVAILABLE'; else if(status<200||status>=300||typeof body?.choices?.[0]?.message?.content!=='string')code='INVALID_PROVIDER_RESPONSE'; return [{json:{ok:code===null,provider:'generic',model:context.selectedModel,modelDiscovery:context.discovery,completionShape:code===null?'valid':'invalid',error:code?{code,retryable:['RATE_LIMITED','PROVIDER_UNAVAILABLE'].includes(code),httpStatus:status||null}:null,warnings:context.discoveryWarning?[context.discoveryWarning]:[]}}];"},"id":"a7777777-7777-4777-8777-777777777777","name":"Safe Connection Report","type":"n8n-nodes-base.code","typeVersion":2,"position":[700,100]},
    {"parameters":{"content":"## Connection Test\n- Configure the same HTTPS Base URL and HTTP Header Auth credential as the gateway.\n- `/models` is capability detection only: an unavailable list adds `MODEL_DISCOVERY_UNAVAILABLE`, then the explicit manual model is tested anyway.\n- The report exposes status classes, never response bodies, headers, prompts, or credential values.\n- No automatic application retry: rerun manually after auth/model correction; 429/5xx are marked retryable.","height":260,"width":460,"color":5},"id":"a8888888-8888-4888-8888-888888888888","name":"How to Read the Test","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-700,-240]}
