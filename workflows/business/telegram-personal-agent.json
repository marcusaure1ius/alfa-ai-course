{
  "id": "businessTelegramPersonalAgentV1",
  "name": "Business · Урок 9 — Telegram: персональный ИИ-помощник",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "# Личный помощник в Telegram\n\n1. Запустите учебный пример вручную.\n2. В блоке **1. Настройте помощника** опишите свой бизнес и задайте вопрос.\n3. ИИ подготовит совет или черновик.\n4. После ручной проверки подключите свой Telegram credential и разрешённый chat ID.\n\nПомощник не отправляет письма, не меняет календарь и ничего не покупает.",
        "height": 330,
        "width": 550,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1240, -420],
      "id": "b9000000-0000-4100-8100-000000000001",
      "name": "Инструкция к уроку"
    },
    {
      "parameters": {
        "content": "## Это помощник, а не исполнитель\n\nВ beginner-версии нет памяти и опасных действий. Каждый ответ — только черновик в n8n. Для приватного бота обязательно ограничьте Telegram trigger своим chat ID.",
        "height": 190,
        "width": 450,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [140, -300],
      "id": "b9000000-0000-4100-8100-000000000002",
      "name": "Границы помощника"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1100, -40],
      "id": "b9000000-0000-4100-8100-000000000003",
      "name": "▶ Запустить тест"
    },
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {
          "download": false,
          "chatIds": "REPLACE_WITH_YOUR_PRIVATE_CHAT_ID"
        }
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [-1100, 180],
      "id": "b9000000-0000-4100-8100-000000000004",
      "name": "Получить личный вопрос",
      "webhookId": "REPLACE_WITH_PERSONAL_AGENT_WEBHOOK_ID",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "REPLACE_WITH_TELEGRAM_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "agent-model",
              "name": "model",
              "value": "openai/gpt-4o",
              "type": "string"
            },
            {
              "id": "agent-context",
              "name": "businessContext",
              "value": "Я управляю небольшой студией дизайна из пяти человек. Помощник помогает с планами, идеями, подготовкой писем и краткими решениями.",
              "type": "string"
            },
            {
              "id": "agent-instruction",
              "name": "instruction",
              "value": "Ты персональный помощник предпринимателя. Давай короткий практичный ответ на русском. Чётко отделяй факты от предположений. Не утверждай, что выполнил действие: ты не отправляешь сообщения, не меняешь календарь, не тратишь деньги и не имеешь памяти между запусками. Если действие рискованное, предложи черновик и шаг ручной проверки.",
              "type": "string"
            },
            {
              "id": "agent-question",
              "name": "question",
              "value": "={{ $json.message?.text || 'Составь план короткой планёрки на понедельник: три проекта задерживаются, а команда перегружена.' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-760, 60],
      "id": "b9000000-0000-4100-8100-000000000005",
      "name": "1. Настройте помощника"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://polza.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $json.model, messages: [{ role: 'system', content: $json.instruction + '\\n\\nКонтекст бизнеса:\\n' + $json.businessContext }, { role: 'user', content: $json.question }], temperature: 0.3, max_tokens: 1000, stream: false }) }}",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 60],
      "id": "b9000000-0000-4100-8100-000000000006",
      "name": "2. Polza готовит ответ",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_POLZA_AI_CREDENTIAL_ID",
          "name": "Polza.ai API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "agent-result",
              "name": "Ответ помощника",
              "value": "={{ $json.choices?.[0]?.message?.content || 'ИИ не ответил. Проверьте Polza credential, баланс и модель в блоке 2.' }}",
              "type": "string"
            },
            {
              "id": "agent-next",
              "name": "Что помнить",
              "value": "Это черновик без памяти и без автоматических действий. Проверьте его перед использованием.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [20, 60],
      "id": "b9000000-0000-4100-8100-000000000007",
      "name": "3. Прочитайте ответ"
    }
  ],
  "connections": {
