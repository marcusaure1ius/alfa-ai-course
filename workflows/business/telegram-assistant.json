{
  "id": "businessTelegramAssistantV1",
  "name": "Business · Урок 1 — Telegram: черновик ответа",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "# Начните здесь\n\n1. Нажмите **Выполнить workflow** — сработает тестовый пример.\n2. Откройте блок **1. Настройте пример** и замените вопрос клиента.\n3. Блок **2. ИИ готовит черновик** обращается к YandexGPT.\n4. Прочитайте ответ в последнем блоке.\n\nЧтобы получать реальные сообщения, позже выберите Telegram credential в зелёном триггере. Код писать не нужно.",
        "height": 300,
        "width": 520,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1240, -420],
      "id": "b1000000-0000-4100-8100-000000000001",
      "name": "Инструкция к уроку"
    },
    {
      "parameters": {
        "content": "## Безопасный результат\n\nЭтот урок только показывает черновик в n8n. Он не отвечает клиенту автоматически. Реальную отправку добавляйте только после отдельного урока про проверку человеком.",
        "height": 180,
        "width": 420,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [140, -300],
      "id": "b1000000-0000-4100-8100-000000000002",
      "name": "Почему ничего не отправится"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1100, -40],
      "id": "b1000000-0000-4100-8100-000000000003",
      "name": "▶ Запустить тест"
    },
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {
          "download": false,
          "chatIds": "REPLACE_WITH_ALLOWED_CHAT_IDS"
        }
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [-1100, 180],
      "id": "b1000000-0000-4100-8100-000000000004",
      "name": "Получить сообщение из Telegram",
      "webhookId": "REPLACE_WITH_TELEGRAM_ASSISTANT_WEBHOOK_ID",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "REPLACE_WITH_TELEGRAM_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tg-model",
              "name": "model",
              "value": "gpt://REPLACE_WITH_FOLDER_ID/yandexgpt/latest",
              "type": "string"
            },
            {
              "id": "tg-folder",
              "name": "folderId",
              "value": "REPLACE_WITH_FOLDER_ID",
              "type": "string"
            },
            {
              "id": "tg-instruction",
              "name": "instruction",
              "value": "Ты помощник малого бизнеса. Подготовь короткий и вежливый черновик ответа клиенту. Не обещай скидки, сроки или действия от имени владельца. В конце предложи человеку проверить ответ.",
              "type": "string"
            },
            {
              "id": "tg-text",
              "name": "text",
              "value": "={{ $json.message?.text || 'Здравствуйте! Подскажите стоимость консультации?' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-760, 60],
      "id": "b1000000-0000-4100-8100-000000000005",
      "name": "1. Настройте пример"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ai.api.cloud.yandex.net/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Project",
              "value": "={{ $json.folderId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $json.model, messages: [{ role: 'system', content: $json.instruction }, { role: 'user', content: $json.text }], temperature: 0.2, max_tokens: 700, stream: false }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 60],
      "id": "b1000000-0000-4100-8100-000000000006",
      "name": "2. ИИ готовит черновик",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YANDEX_AI_STUDIO_CREDENTIAL_ID",
          "name": "Yandex AI Studio Api-Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tg-result",
              "name": "Черновик ответа",
              "value": "={{ $json.choices?.[0]?.message?.content || 'ИИ не ответил. Проверьте folderId, model и Yandex credential в блоке 2.' }}",
              "type": "string"
            },
            {
              "id": "tg-next",
              "name": "Следующий шаг",
              "value": "Прочитайте черновик и исправьте его вручную. В этом уроке сообщение клиенту не отправляется.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [20, 60],
      "id": "b1000000-0000-4100-8100-000000000007",
      "name": "3. Проверьте черновик"
    }
  ],
