{
  "id": "businessDailyExecutiveDigestV1",
  "name": "Business · Урок 4 — Сводка руководителю",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "# Цифры дня → короткая сводка\n\n1. Запустите тест.\n2. В блоке **1. Введите цифры дня** замените учебные показатели.\n3. ИИ подготовит понятную сводку.\n4. Последний блок покажет Telegram preview: ничего не отправится.\n\nПозже расписание может запускать workflow каждый день в 09:00.",
        "height": 300,
        "width": 520,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1340, -440],
      "id": "b4000000-0000-4100-8100-000000000001",
      "name": "Инструкция к уроку"
    },
    {
      "parameters": {
        "content": "## Telegram в режиме preview\n\nПоследний блок только показывает готовый текст внутри n8n. Блока отправки Telegram в уроке нет.",
        "height": 190,
        "width": 430,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [140, -320],
      "id": "b4000000-0000-4100-8100-000000000002",
      "name": "Без реальной отправки"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, -40],
      "id": "b4000000-0000-4100-8100-000000000003",
      "name": "▶ Запустить тест"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1200, 180],
      "id": "b4000000-0000-4100-8100-000000000004",
      "name": "Каждый день в 09:00"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "digest-model",
              "name": "model",
              "value": "gpt://REPLACE_WITH_FOLDER_ID/yandexgpt/latest",
              "type": "string"
            },
            {
              "id": "digest-folder",
              "name": "folderId",
              "value": "REPLACE_WITH_FOLDER_ID",
              "type": "string"
            },
            {
              "id": "digest-instruction",
              "name": "instruction",
              "value": "Ты помощник руководителя. Напиши короткую сводку из 4 пунктов: что произошло, что хорошо, где нужно внимание и одно действие на сегодня. Используй только переданные цифры.",
              "type": "string"
            },
            {
              "id": "digest-text",
              "name": "text",
              "value": "Новые заявки: 8\nПродажи: 3\nПисьма без ответа: 2\nПросроченные задачи: 1",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-860, 60],
      "id": "b4000000-0000-4100-8100-000000000005",
      "name": "1. Введите цифры дня"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ai.api.cloud.yandex.net/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Project",
              "value": "={{ $json.folderId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $json.model, messages: [{ role: 'system', content: $json.instruction }, { role: 'user', content: $json.text }], temperature: 0.2, max_tokens: 700, stream: false }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-500, 60],
      "id": "b4000000-0000-4100-8100-000000000006",
      "name": "2. ИИ пишет сводку",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YANDEX_AI_STUDIO_CREDENTIAL_ID",
          "name": "Yandex AI Studio Api-Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "digest-message",
              "name": "Telegram preview",
              "value": "={{ $json.choices?.[0]?.message?.content || 'ИИ не ответил. Проверьте folderId, model и Yandex credential в блоке 2.' }}",
              "type": "string"
            },
            {
              "id": "digest-next",
              "name": "Что сделать",
              "value": "Проверьте цифры и текст. В этом уроке сообщение в Telegram не отправляется.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-120, 60],
      "id": "b4000000-0000-4100-8100-000000000007",
      "name": "3. Посмотрите Telegram preview"
    }
  ],
