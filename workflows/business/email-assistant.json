{
  "id": "businessEmailAssistantV1",
  "name": "Business · Урок 2 — Почта: черновик ответа",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "# Письмо → черновик ответа\n\n1. Нажмите **Выполнить workflow** для теста.\n2. В блоке **1. Настройте пример письма** можно изменить тему и текст.\n3. ИИ подготовит ответ.\n4. Последний блок покажет черновик — письмо не отправляется.\n\nДля Gmail или Яндекс Почты позже выберите IMAP credential в зелёном блоке.",
        "height": 300,
        "width": 520,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1240, -420],
      "id": "b2000000-0000-4100-8100-000000000001",
      "name": "Инструкция к уроку"
    },
    {
      "parameters": {
        "content": "## Почему это безопасно\n\nВ workflow нет блока отправки почты. Результат остаётся черновиком в истории выполнения n8n. Перед реальным ответом его читает и копирует человек.",
        "height": 180,
        "width": 420,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [160, -300],
      "id": "b2000000-0000-4100-8100-000000000002",
      "name": "Письмо не отправляется"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1100, -40],
      "id": "b2000000-0000-4100-8100-000000000003",
      "name": "▶ Запустить тест"
    },
    {
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "downloadAttachments": false,
        "format": "simple",
        "options": {
          "customEmailConfig": "[\"UNSEEN\"]",
          "trackLastMessageId": true,
          "forceReconnect": 60
        }
      },
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [-1100, 180],
      "id": "b2000000-0000-4100-8100-000000000004",
      "name": "Получить новое письмо",
      "credentials": {
        "imap": {
          "id": "REPLACE_WITH_IMAP_CREDENTIAL_ID",
          "name": "REPLACE_WITH_IMAP_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "mail-model",
              "name": "model",
              "value": "gpt://REPLACE_WITH_FOLDER_ID/yandexgpt/latest",
              "type": "string"
            },
            {
              "id": "mail-folder",
              "name": "folderId",
              "value": "REPLACE_WITH_FOLDER_ID",
              "type": "string"
            },
            {
              "id": "mail-instruction",
              "name": "instruction",
              "value": "Ты помощник предпринимателя. Подготовь вежливый черновик ответа на письмо. Не придумывай цены, сроки и факты. Если информации не хватает, задай один уточняющий вопрос. Верни только текст письма.",
              "type": "string"
            },
            {
              "id": "mail-text",
              "name": "text",
              "value": "={{ 'Тема: ' + ($json.subject || 'Запрос стоимости') + '\\n\\nПисьмо: ' + ($json.text || 'Здравствуйте! Хотим заказать консультацию. Подскажите стоимость и ближайшую дату.') }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-760, 60],
      "id": "b2000000-0000-4100-8100-000000000005",
      "name": "1. Настройте пример письма"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ai.api.cloud.yandex.net/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Project",
              "value": "={{ $json.folderId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $json.model, messages: [{ role: 'system', content: $json.instruction }, { role: 'user', content: $json.text }], temperature: 0.2, max_tokens: 700, stream: false }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 60],
      "id": "b2000000-0000-4100-8100-000000000006",
      "name": "2. ИИ пишет ответ",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YANDEX_AI_STUDIO_CREDENTIAL_ID",
          "name": "Yandex AI Studio Api-Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "mail-result",
              "name": "Черновик письма",
              "value": "={{ $json.choices?.[0]?.message?.content || 'ИИ не ответил. Проверьте folderId, model и Yandex credential в блоке 2.' }}",
              "type": "string"
            },
            {
              "id": "mail-next",
              "name": "Что сделать",
              "value": "Проверьте факты, цены и даты. Затем вручную скопируйте согласованный текст в почту.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [20, 60],
      "id": "b2000000-0000-4100-8100-000000000007",
      "name": "3. Проверьте черновик"
    }
  ],
