            "text": "={{ $('1. Настройки и безопасный пример').item.json.text }}",
            "received_at": "={{ $('1. Настройки и безопасный пример').item.json.receivedAt }}",
            "route": "={{ $('1. Настройки и безопасный пример').item.json.isStartCommand ? 'new_or_restart' : 'known' }}"
          },
