# Только для управляемой среды Neurokurs. Не коммитьте заполненный файл.
N8N_GATE_MANAGEMENT_SECRET=replace-with-at-least-32-random-bytes

# Имя файла подтверждения владения в поисковой консоли, без ведущего слэша.
# Оно привязано к аккаунту владельца, а не к сайту, поэтому в общий профиль не
# входит и задаётся на конкретном хосте. Строку можно не задавать вовсе — тогда
# endpoint остаётся на инертном пути. Но ПУСТОЕ значение задавать нельзя: Caddy
# подставит матчер `/` и перехватит корень сайта.
#SITE_VERIFICATION_FILE=googlexxxxxxxxxxxxxxxx.html
